# What a pushed lab/* branch runs on GitHub Actions (.github/workflows/lab.yml): the spec under test/specs and its
# settings, read as environment variables by every shard.
LAB_TEST=lsdiag.mjs
LSD_M=30
LSD_VARS=farTraitK=0,farNoTrait=1,farBase=0,farShotK=1,lsRangeK=1,lsEdge=0,lsFadeTo=0,lsFindK=0/lsEdge=21
